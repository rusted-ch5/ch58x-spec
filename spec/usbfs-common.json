    },
    {
      "name": "INT_EN",
      "offset": 2,
      "width": 8,
      "access": "read-write",
      "evidence": "source-correlated",
      "description": "Interrupt enable bits corresponding to INT_FG events.",
      "sources": ["openwch-ch583-evt-v2.4", "tinyusb-ch32-usbfs"]
    },
    {
      "name": "DEV_AD",
      "offset": 3,
      "width": 8,
      "access": "read-write",
      "evidence": "hardware-observed",
      "description": "USB device address; the low seven bits contain the assigned address.",
      "sources": ["openwch-ch583-evt-v2.4", "ch582-usb-observation-2026-08", "ch585-usb-observation-2026-08"],
      "fields": [
        {
          "name": "ADDRESS",
          "lsb": 0,
          "width": 7,
          "evidence": "hardware-observed",
          "description": "Device address written after the status stage of SET_ADDRESS."
        }
      ]
    },
    {
      "name": "MIS_ST",
      "offset": 5,
      "width": 8,
      "access": "read-only",
      "evidence": "source-correlated",
      "description": "Miscellaneous line, suspend, and attachment status.",
      "sources": ["openwch-ch583-evt-v2.4", "tinyusb-ch32-usbfs"]
    },
    {
      "name": "INT_FG",
      "offset": 6,
      "width": 8,
      "access": "write-one-to-clear",
      "evidence": "hardware-observed",
      "description": "Interrupt flags. Status and RX length must be captured before the event flag is cleared.",
      "sources": ["openwch-ch583-evt-v2.4", "ch582-usb-observation-2026-08", "ch585-usb-observation-2026-08"],
      "fields": [
        {
          "name": "BUS_RESET",
          "lsb": 0,
          "width": 1,
          "evidence": "hardware-observed",
          "description": "USB bus reset event."
        },
        {
          "name": "TRANSFER",
          "lsb": 1,
          "width": 1,
          "evidence": "hardware-observed",
          "description": "Token transfer completed."
        },
        {
          "name": "SUSPEND",
          "lsb": 2,
          "width": 1,
          "evidence": "hardware-observed",
          "description": "Suspend or resume line-state event."
        }
      ]
    },
    {
      "name": "INT_ST",
      "offset": 7,
      "width": 8,
      "access": "read-only",
      "evidence": "hardware-observed",
      "description": "Latest transaction status. SETUP_ACT is authoritative before the endpoint nibble is interpreted.",
      "sources": ["openwch-ch583-evt-v2.4", "ch582-usb-observation-2026-08", "ch585-usb-observation-2026-08"],
      "fields": [
        {
          "name": "ENDPOINT",
          "lsb": 0,
          "width": 4,
          "evidence": "source-correlated",
          "description": "Endpoint number for non-SETUP transactions."
        },
        {
          "name": "TOKEN",
          "lsb": 4,
          "width": 2,
          "evidence": "source-correlated",
          "description": "OUT, IN, or SETUP token encoding."
        },
        {
          "name": "TOGGLE_OK",
          "lsb": 6,
          "width": 1,
          "evidence": "hardware-observed",
          "description": "Received OUT data toggle matched the expected PID."
        },
        {
          "name": "SETUP_ACTIVE",
          "lsb": 7,
          "width": 1,
          "evidence": "hardware-observed",
          "description": "The completed transaction is an EP0 SETUP packet."
        }
      ]
    },
    {
      "name": "RX_LEN",
      "offset": 8,
      "width": 8,
      "access": "read-only",
      "evidence": "hardware-observed",
      "description": "Received payload length for the completed OUT or SETUP transaction.",
      "sources": ["openwch-ch583-evt-v2.4", "ch582-usb-observation-2026-08", "ch585-usb-observation-2026-08"]
    },
