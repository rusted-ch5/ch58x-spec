    {
      "id": "openwch-ch583-evt-v2.4",
      "kind": "public-source",
      "reference": "https://github.com/openwch/ch583/tree/bd508ad7ceed48377619837051412a651952857f/EVT/EXAM/USB/Device",
      "note": "Public device examples and register definitions."
    },
    {
      "id": "tinyusb-ch32-usbfs",
      "kind": "public-source",
      "reference": "https://github.com/hathach/tinyusb/tree/801be6c97f972b730b915708e7c4505cf7c83454/src/portable/wch",
      "note": "Independent USBFS endpoint and toggle implementation."
    },
    {
      "id": "ch582-usb-observation-2026-08",
      "kind": "hardware-observation",
      "reference": "CH582M standalone enumeration, control transfer, CDC, HID, clear-halt, and reset tests",
      "note": "Applies to the recorded CH582M board and exact test images."
    },
    {
      "id": "ch585-usb-observation-2026-08",
      "kind": "hardware-observation",
      "reference": "CH585M standalone USBFS CDC and vendor HID tests under lease 7a9df39d904947b3",
      "note": "Validated CH585 DMA encoding and endpoint traffic."
    }
  ],
  "registers": [
    {
      "name": "CTRL",
      "offset": 0,
      "width": 8,
      "access": "read-write",
      "evidence": "source-correlated",
      "description": "USB controller mode, DMA, reset, and low-power control.",
      "sources": ["openwch-ch583-evt-v2.4", "tinyusb-ch32-usbfs"]
    },
    {
      "name": "UDEV_CTRL",
      "offset": 1,
      "width": 8,
      "access": "read-write",
      "evidence": "hardware-observed",
      "description": "USB device port enable and physical transceiver control.",
