{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "name",
    "description",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "ble-vectors"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "advertising",
              "static-address",
              "advertising-data",
              "event-mask",
              "connection-parameters",
              "disconnect-reason",
              "capture-ack",
              "tx-countdown",
              "rx-countdown",
              "receive-length"
            ]
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
