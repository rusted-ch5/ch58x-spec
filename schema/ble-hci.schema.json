{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "name",
    "status",
    "primary_chip",
    "adaptations",
    "byte_order",
    "sources",
    "transport",
    "commands",
    "events",
    "status_codes",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "ble-hci-contract"
    },
    "name": {
      "const": "ch585_ble_hci"
    },
    "status": {
      "enum": [
        "work-in-progress",
        "accepted"
      ]
    },
    "primary_chip": {
      "const": "CH585"
    },
    "adaptations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "byte_order": {
      "const": "little-endian"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "public-document",
              "public-source"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "transport": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "opcode",
          "name",
          "parameter_length",
          "response",
          "fields",
          "rule",
          "core_section"
        ],
        "properties": {
          "opcode": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parameter_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "response": {
            "enum": [
              "command-complete",
              "command-status"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "offset",
                "width",
                "encoding",
                "constraint"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "encoding": {
                  "enum": [
                    "u8",
                    "u16le",
                    "u64le",
                    "bytes",
                    "bytes-le"
                  ]
                },
                "constraint": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "core_section": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1
    },
    "status_codes": {
      "type": "object"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "enum": [
              "source-audit",
              "host-vectors",
              "scripted-controller",
              "hardware"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
